# URL pública HTTPS (túnel cloudflared/ngrok). Obligatoria para Web Push y micrófono.
PUBLIC_BASE_URL=https://xxxx.trycloudflare.com

# Agente — heredado de Mateo-main
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Voz — dos presentaciones del asistente
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_MATEO=
ELEVENLABS_VOICE_ID_EMILIA=

# Web Push (generar con: python -m py_vapid --gen)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@vesta.cl

# Demo
DEMO_MODE=true
VESTA_USER_ID=usr_01
HEALTH_SOURCE=manual        # manual | photo | bluetooth | simulated
