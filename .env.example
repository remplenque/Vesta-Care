# Copy to .env.local (Next.js) — never commit the real file.
# Proposed names: adjust to whatever the code actually reads, in the same commit.

# Supabase — public, safe in the browser (RLS protects the data)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=  # publishable (sb_publishable_…) or legacy anon key

# Demo wiring — fictional data. Used by /demo (scenario panel) and its links
NEXT_PUBLIC_DEMO_USER_ID=       # profiles.id of Don Luis (scripts/create-demo-user.sql prints it)
NEXT_PUBLIC_DEMO_CONTACT_TOKEN= # emergency_contacts.access_token of his son → /c/[token]

# Supabase — SERVER ONLY. Never import in client code, never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=      # /api/demo/*: creates and simulates the 3 demo personas (lib/personas.ts)
SUPABASE_PROJECT_ID=            # only for: supabase gen types
# Without the service role key, /api/demo/reset signs in as the demo user to call reset_demo
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=             # also the password of the other personas (rosa@ / jorge@vestacare.cl)
# Phone login (demo, no SMS code): numbers allowed to sign in as the demo user. SERVER ONLY
LOGIN_PHONES=                   # e.g. +569XXXXXXXX,+569YYYYYYYY (real numbers only in .env.local)

# LLM via Vercel AI SDK — in use: Anthropic (docs/OPEN-ISSUES.md #4). SERVER ONLY
ANTHROPIC_API_KEY=              # @ai-sdk/anthropic
ANTHROPIC_MODEL=claude-haiku-4-5
# GOOGLE_GENERATIVE_AI_API_KEY= # @ai-sdk/google (legacy used Gemini)

# Companion voice (optional) — ElevenLabs via /api/tts. SERVER ONLY. Without it: browser voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICES=Mateo:JBFqnCBsd6RMkjVDRZzb,Emilia:EXAVITQu4vr4xnSDxMaL   # Name:voice_id (premade voices; library voices need a paid plan)
ELEVENLABS_MODEL=eleven_flash_v2_5

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipo@vesta.cl

# Real WhatsApp to caregivers (optional, SERVER ONLY). Off unless WHATSAPP_REAL=1; even then only the
# numbers in WHATSAPP_REAL_TO get a real message, everyone else stays in the simulated feed.
# Twilio sandbox: each of those phones must first send "join <code>" to the sandbox number.
WHATSAPP_REAL=0
WHATSAPP_REAL_TO=                # e.g. +569XXXXXXXX (real numbers only in .env.local)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
PUBLIC_APP_URL=                  # base URL for the /c/<token> links in the messages (LAN IP or deploy)
